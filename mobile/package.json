{
  "name": "brand-nation-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Brand Nation Android and iOS Capacitor app prototype",
  "scripts": {
    "sync": "npm run build && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "check": "node --check src/app.js",
    "build": "esbuild src/app.js --bundle --format=esm --outfile=www/app.js"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/app": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.25.0"
  }
}
